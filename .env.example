# LLM
GROQ_API_KEY=
GEMINI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Gmail (IMAP — App Password, NOT account password)
# Setup: Google Account → Security → App Passwords → Mail → Generate
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Google (MCP — already partially configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Weather
OPENWEATHERMAP_API_KEY=
WEATHER_CITY=Israel

# Scheduling
BRIEFING_HOUR=7
BRIEFING_MINUTE=30

# Agent Tools — Phase D
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
BRAVE_SEARCH_API_KEY=BSAxxxxxxxxxxxxxxxx
EXA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# Paths
LEDGERALPHA_SIGNALS_PATH=/path/to/PROJECT-SANTIMENT/engine/signals
BASH_LOG_PATH=/path/to/bash-log.txt
PROJECTS_BASE_PATH=/path/to/Projects

# Voice
WAKE_WORD=hey jarvis
VOICE_ENABLED=false

# Regime Guard
REGIME_CHECK_INTERVAL_HOURS=2
REGIME_ALERT_THRESHOLD=-0.6
